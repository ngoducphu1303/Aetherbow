rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1 / Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared hardened primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUuidV4(id) {
      return id is string
        && id.size() == 36
        && id.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isGoogleAssetAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'puugoo002@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isAssetAdmin() {
      return isGoogleAssetAdmin()
        || (isSignedIn() && exists(/databases/$(database)/documents/asset_admins/$(request.auth.uid)));
    }

    // Validation Blueprint 1: PlayerAccount (/players/{uid})
    function isValidPlayerAccount(data, uid) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'username',
        'authProvider',
        'saveVersion',
        'powerRating',
        'highestChapterCleared',
        'saveData',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid',
        'displayName',
        'username',
        'authProvider',
        'saveVersion',
        'powerRating',
        'highestChapterCleared',
        'saveData',
        'createdAt',
        'updatedAt'
      ])
      && data.uid is string
      && data.uid == request.auth.uid
      && data.uid == uid
      && isValidId(data.uid)
      && data.displayName is string
      && data.displayName.size() >= 2
      && data.displayName.size() <= 24
      && data.username is string
      && data.username.size() <= 64
      && data.authProvider is string
      && data.authProvider in ['password', 'google']
      && data.saveVersion is int
      && data.saveVersion >= 1
      && data.saveVersion <= 100
      && data.powerRating is number
      && data.powerRating >= 0
      && data.powerRating <= 1000000000
      && data.highestChapterCleared is int
      && data.highestChapterCleared >= 0
      && data.highestChapterCleared <= 100
      && data.saveData is map
      && data.saveData.keys().size() >= 1
      && data.saveData.keys().size() <= 260
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // Validation Blueprint 2: LeaderboardEntry (/leaderboard/{uid})
    function isValidLeaderboardEntry(data, uid) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'heroId',
        'heroName',
        'title',
        'equippedAvatarFrameId',
        'powerRating',
        'highestChapterCleared',
        'bestTowerFloor',
        'arenaRating',
        'worldBossBestDamage',
        'vipLevel',
        'isPublic',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid',
        'displayName',
        'heroId',
        'heroName',
        'title',
        'equippedAvatarFrameId',
        'powerRating',
        'highestChapterCleared',
        'bestTowerFloor',
        'arenaRating',
        'worldBossBestDamage',
        'vipLevel',
        'isPublic',
        'createdAt',
        'updatedAt'
      ])
      && data.uid is string
      && data.uid == request.auth.uid
      && data.uid == uid
      && isValidId(data.uid)
      && data.displayName is string
      && data.displayName.size() >= 2
      && data.displayName.size() <= 24
      && data.heroId is string
      && data.heroId.size() >= 1
      && data.heroId.size() <= 32
      && data.heroId.matches('^[a-zA-Z0-9_\\-]+$')
      && data.heroName is string
      && data.heroName.size() >= 1
      && data.heroName.size() <= 32
      && data.title is string
      && data.title.size() >= 1
      && data.title.size() <= 48
      && data.equippedAvatarFrameId is string
      && data.equippedAvatarFrameId.size() >= 1
      && data.equippedAvatarFrameId.size() <= 48
      && data.equippedAvatarFrameId.matches('^[a-zA-Z0-9_\\-]+$')
      && data.powerRating is number
      && data.powerRating >= 0
      && data.powerRating <= 1000000000
      && data.highestChapterCleared is int
      && data.highestChapterCleared >= 0
      && data.highestChapterCleared <= 100
      && data.bestTowerFloor is int
      && data.bestTowerFloor >= 0
      && data.bestTowerFloor <= 10000
      && data.arenaRating is number
      && data.arenaRating >= 0
      && data.arenaRating <= 1000000
      && data.worldBossBestDamage is number
      && data.worldBossBestDamage >= 0
      && data.worldBossBestDamage <= 10000000000
      && data.vipLevel is int
      && data.vipLevel >= 0
      && data.vipLevel <= 30
      && data.isPublic is bool
      && data.isPublic == true
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // Validation Blueprint 3: BossRaceEntry (/boss_race_entries/{entryId})
    function isValidBossRaceEntry(data, entryId) {
      return data.keys().hasAll([
        'uid',
        'weekId',
        'displayName',
        'heroId',
        'bestScore',
        'bestDamage',
        'bestClearTimeMs',
        'perfectDodges',
        'autoPilotUsed',
        'isPublic',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid',
        'weekId',
        'displayName',
        'heroId',
        'bestScore',
        'bestDamage',
        'bestClearTimeMs',
        'perfectDodges',
        'autoPilotUsed',
        'isPublic',
        'createdAt',
        'updatedAt'
      ])
      && data.uid is string
      && data.uid == request.auth.uid
      && isValidId(data.uid)
      && data.weekId is string
      && data.weekId.size() >= 4
      && data.weekId.size() <= 24
      && data.weekId.matches('^[a-zA-Z0-9_\\-]+$')
      && entryId == (data.weekId + '_' + data.uid)
      && data.displayName is string
      && data.displayName.size() >= 2
      && data.displayName.size() <= 24
      && data.heroId is string
      && data.heroId.size() >= 1
      && data.heroId.size() <= 32
      && data.heroId.matches('^[a-zA-Z0-9_\\-]+$')
      && data.bestScore is number
      && data.bestScore >= 0
      && data.bestScore <= 100000000
      && data.bestDamage is number
      && data.bestDamage >= 0
      && data.bestDamage <= 10000000000
      && data.bestClearTimeMs is int
      && data.bestClearTimeMs >= 0
      && data.bestClearTimeMs <= 600000
      && data.perfectDodges is int
      && data.perfectDodges >= 0
      && data.perfectDodges <= 500
      && data.autoPilotUsed is bool
      && data.isPublic is bool
      && data.isPublic == true
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // Validation Blueprint 4: SeasonStanding (/season_standings/{standingId})
    function isValidSeasonStanding(data, standingId) {
      return data.keys().hasAll([
        'uid',
        'seasonId',
        'displayName',
        'heroId',
        'seasonPoints',
        'weeksParticipated',
        'equalizedArenaWins',
        'rankTier',
        'claimedMilestones',
        'isPublic',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid',
        'seasonId',
        'displayName',
        'heroId',
        'seasonPoints',
        'weeksParticipated',
        'equalizedArenaWins',
        'rankTier',
        'claimedMilestones',
        'isPublic',
        'createdAt',
        'updatedAt'
      ])
      && data.uid is string
      && data.uid == request.auth.uid
      && isValidId(data.uid)
      && data.seasonId is string
      && data.seasonId.size() >= 2
      && data.seasonId.size() <= 24
      && data.seasonId.matches('^[a-zA-Z0-9_\\-]+$')
      && standingId == (data.seasonId + '_' + data.uid)
      && data.displayName is string
      && data.displayName.size() >= 2
      && data.displayName.size() <= 24
      && data.heroId is string
      && data.heroId.size() >= 1
      && data.heroId.size() <= 32
      && data.heroId.matches('^[a-zA-Z0-9_\\-]+$')
      && data.seasonPoints is int
      && data.seasonPoints >= 0
      && data.seasonPoints <= 1000000
      && data.weeksParticipated is int
      && data.weeksParticipated >= 0
      && data.weeksParticipated <= 12
      && data.equalizedArenaWins is int
      && data.equalizedArenaWins >= 0
      && data.equalizedArenaWins <= 10000
      && data.rankTier is string
      && data.rankTier in ['bronze', 'silver', 'gold', 'platinum', 'astral_emperor']
      && data.claimedMilestones is list
      && data.claimedMilestones.size() <= 20
      && (data.claimedMilestones.size() == 0 || data.claimedMilestones[0] is string)
      && data.isPublic is bool
      && data.isPublic == true
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // Validation Blueprint 5: AssetAdminRecord (/asset_admins/{uid})
    function isValidAssetAdminRecord(data, uid) {
      return data.keys().hasAll([
        'uid',
        'handle',
        'grantedBy',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid',
        'handle',
        'grantedBy',
        'createdAt',
        'updatedAt'
      ])
      && data.uid is string
      && data.uid == uid
      && isValidId(data.uid)
      && data.handle is string
      && data.handle in ['puugoo']
      && data.grantedBy is string
      && data.grantedBy == request.auth.uid
      && isValidId(data.grantedBy)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // Validation Blueprint 6: AssetInboxItem (/asset_inbox/{assetId})
    function isValidAssetInboxItem(data, assetId) {
      return data.keys().hasAll([
        'id',
        'name',
        'chapter',
        'group',
        'path',
        'size',
        'uploadedAt',
        'isPublic',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'id',
        'name',
        'chapter',
        'group',
        'path',
        'size',
        'uploadedAt',
        'isPublic',
        'createdAt',
        'updatedAt'
      ])
      && isValidUuidV4(data.id)
      && data.id == assetId
      && data.name is string
      && data.name.size() >= 5
      && data.name.size() <= 120
      && data.name.matches('^[^/\\\\]+\\.[gG][lL][bB]$')
      && !data.name.matches('.*\\.\\..*')
      && data.chapter is int
      && data.chapter >= 1
      && data.chapter <= 12
      && data.group is string
      && data.group in ['map', 'hero', 'enemy', 'boss', 'companion', 'other']
      && data.path is string
      && data.path.size() >= 15
      && data.path.size() <= 320
      && !data.path.matches('.*\\.\\..*')
      && data.path.matches('^/assets/Chương ([1-9]|1[0-2])/Asset mới/[^/\\\\]+/' + data.id + '/[^/\\\\]+\\.[gG][lL][bB]$')
      && data.size is int
      && data.size >= 24
      && data.size <= 120000000
      && data.uploadedAt is string
      && data.uploadedAt.size() >= 20
      && data.uploadedAt.size() <= 32
      && data.uploadedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$')
      && data.isPublic is bool
      && data.isPublic == true
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // Collection 1: Private Player Accounts & Full Progression Saves (PII Isolated)
    match /players/{uid} {
      allow get: if isOwner(uid) && isValidId(uid);
      allow list: if false;
      allow create: if isOwner(uid)
        && isValidId(uid)
        && isValidPlayerAccount(incoming(), uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(uid)
        && isValidId(uid)
        && isValidPlayerAccount(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Full cloud save synchronization
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'username',
            'authProvider',
            'saveVersion',
            'powerRating',
            'highestChapterCleared',
            'saveData',
            'updatedAt'
          ])
          // Action 2: Display name update only
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'updatedAt'
          ])
        );
      allow delete: if false;
    }

    // Collection 2: Public PII-Free Leaderboard Entries
    match /leaderboard/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || (resource != null && existing().isPublic == true));
      allow list: if resource.data.isPublic == true;
      allow create: if isOwner(uid)
        && isValidId(uid)
        && isValidLeaderboardEntry(incoming(), uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(uid)
        && isValidId(uid)
        && isValidLeaderboardEntry(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Sync leaderboard stats
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'heroId',
            'heroName',
            'title',
            'equippedAvatarFrameId',
            'powerRating',
            'highestChapterCleared',
            'bestTowerFloor',
            'arenaRating',
            'worldBossBestDamage',
            'vipLevel',
            'isPublic',
            'updatedAt'
          ])
          // Action 2: Display name update only
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'updatedAt'
          ])
        );
      allow delete: if false;
    }

    // Collection 3: Public PII-Free Weekly Boss Race Entries
    match /boss_race_entries/{entryId} {
      allow get: if isValidId(entryId)
        && (
          (resource != null && existing().isPublic == true)
          || (isSignedIn() && (resource == null || existing().uid == request.auth.uid))
        );
      allow list: if resource.data.isPublic == true;
      allow create: if isSignedIn()
        && isValidId(entryId)
        && isValidBossRaceEntry(incoming(), entryId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(entryId)
        && isValidBossRaceEntry(incoming(), entryId)
        && existing().uid == request.auth.uid
        && incoming().uid == existing().uid
        && incoming().weekId == existing().weekId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().bestScore >= existing().bestScore
        && (
          // Action 1: Update weekly best score & telemetry
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'heroId',
            'bestScore',
            'bestDamage',
            'bestClearTimeMs',
            'perfectDodges',
            'autoPilotUsed',
            'isPublic',
            'updatedAt'
          ])
          // Action 2: Display name sync
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'updatedAt'
          ])
        );
      allow delete: if false;
    }

    // Collection 4: Public PII-Free Competitive Season Standings
    match /season_standings/{standingId} {
      allow get: if isValidId(standingId)
        && (
          (resource != null && existing().isPublic == true)
          || (isSignedIn() && (resource == null || existing().uid == request.auth.uid))
        );
      allow list: if resource.data.isPublic == true;
      allow create: if isSignedIn()
        && isValidId(standingId)
        && isValidSeasonStanding(incoming(), standingId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(standingId)
        && isValidSeasonStanding(incoming(), standingId)
        && existing().uid == request.auth.uid
        && incoming().uid == existing().uid
        && incoming().seasonId == existing().seasonId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().seasonPoints >= existing().seasonPoints
        && incoming().equalizedArenaWins >= existing().equalizedArenaWins
        && (
          // Action 1: Sync season points, Fair-Play wins, rank tier & claimed milestones
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'heroId',
            'seasonPoints',
            'weeksParticipated',
            'equalizedArenaWins',
            'rankTier',
            'claimedMilestones',
            'isPublic',
            'updatedAt'
          ])
          // Action 2: Claim seasonal milestone tier standalone
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'claimedMilestones',
            'updatedAt'
          ])
        );
      allow delete: if false;
    }

    // Collection 5: Private Asset Admin Allowlist (Google Owner Managed Only)
    match /asset_admins/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isGoogleAssetAdmin());
      allow list: if false;
      allow create: if isGoogleAssetAdmin()
        && isValidId(uid)
        && isValidAssetAdminRecord(incoming(), uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isGoogleAssetAdmin()
        && isValidId(uid)
        && isValidAssetAdminRecord(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'handle',
          'grantedBy',
          'updatedAt'
        ]);
      allow delete: if isGoogleAssetAdmin() && isValidId(uid);
    }

    // Collection 6: Public Read-Only Mirror of Uploaded GLB Inbox Metadata
    match /asset_inbox/{assetId} {
      allow get: if isValidUuidV4(assetId)
        && ((resource != null && existing().isPublic == true) || isAssetAdmin());
      allow list: if resource.data.isPublic == true;
      allow create: if isAssetAdmin()
        && isValidUuidV4(assetId)
        && isValidAssetInboxItem(incoming(), assetId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAssetAdmin()
        && isValidUuidV4(assetId)
        && isValidAssetInboxItem(incoming(), assetId)
        && incoming().id == existing().id
        && incoming().path == existing().path
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'chapter',
          'group',
          'size',
          'uploadedAt',
          'isPublic',
          'updatedAt'
        ]);
      allow delete: if isAssetAdmin() && isValidUuidV4(assetId);
    }
  }
}
